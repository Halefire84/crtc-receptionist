NODE_ENV=development
HOST=127.0.0.1
PORT=8789
PUBLIC_BASE_URL=https://YOUR-APPROVED-HOSTNAME
PUBLIC_WS_URL=wss://YOUR-APPROVED-HOSTNAME/conversation-relay
TEXML_WEBHOOK_TOKEN=GENERATE-A-LONG-RANDOM-SECRET

# --- AI brain: Claude API -------------------------------------------------------------
# Set ANTHROPIC_API_KEY in the host's secret store or a git-ignored .env. Never commit it,
# never paste it in chat, logs or docs. Without it the service uses the local Ollama path.
ANTHROPIC_API_KEY=
AI_BACKEND=claude
CLAUDE_TRIAGE_MODEL=claude-haiku-5-5
CLAUDE_VOICE_MODEL=claude-haiku-5-5
CLAUDE_HEAVY_MODEL=claude-sonnet-5-5
# Receptionist's own monthly stop (estimated USD from the usage log). The org credit and
# the org's $200/month cap are separate and set in the Anthropic Console.
CLAUDE_MONTHLY_BUDGET_USD=20

# --- Owner/operator API (Bearer token). Empty = operator API off. -----------------------
OPERATOR_TOKEN=

# --- Telnyx messaging (v2). Empty = no texts are sent; everything stays a draft. ----------
TELNYX_API_KEY=
TELNYX_MESSAGING_FROM=
TELNYX_MESSAGING_PROFILE_ID=
# Base64 public key from Mission Control (Account > Keys). When set, /sms/inbound requires a valid signature.
TELNYX_PUBLIC_KEY=

# --- Tenants (one JSON per business; see tenants.example/) ------------------------------
TENANTS_DIR=./tenants

# --- Legacy local model path (used when AI_BACKEND=ollama) ------------------------------
OLLAMA_OPENAI_URL=http://127.0.0.1:11435/v1
OLLAMA_MODEL=qwen3:4b
AI_TIMEOUT_MS=18000
TELNYX_VOICE=Telnyx.Ultra.Callie
TELNYX_LANGUAGE=en
TELNYX_TRANSCRIPTION_PROVIDER=deepgram
DB_PATH=./data/receptionist.sqlite
